---
import { Font } from 'astro:assets';
import { Image } from 'astro:assets';
import heroImg from '../assets/consultant-ia-malgache-neuralink-clavier.jpg';
import duoImg from '../assets/consultants-ia-madagascar-cyborgs.jpg';
import implantImg from '../assets/puce-neuralink-consultant-malgache.jpg';

// CTA principal : création de l'espace client + dépôt de la demande.
const CTA_URL = 'https://reporting.claudeagency.fr/client?nouveau=1';

const MAILTO =
  'mailto:contact@claudeagency.fr?subject=Je%20veux%20ma%20semaine%20offerte&body=Salut%20Julien%2C%0A%0AJe%20veux%20ma%20semaine.%0A%0AMes%203%20challenges%20%3A%0A1.%20%0A2.%20%0A3.%20%0A%0ADates%20souhait%C3%A9es%20%3A%20%0AMon%20site%20%3A%20%0A%0AEt%20oui%2C%20je%20sais%20que%20je%20te%20dois%20une%20vid%C3%A9o%20et%205%20%C3%A9toiles.';

const site = 'https://claudeagency.fr';
const title = 'Une semaine de consultant IA offerte · Claude Agency';
const description =
  "Offre réservée à mes amis entrepreneurs du web : un consultant IA formé pendant 5 jours ouvrés, 3 challenges, licence Claude Max incluse, 500 € de valeur, 0 € à payer.";

const heroPoints = [
  '35 heures de travail réel, pas 35 heures de réunions',
  '3 projets qui traînent depuis mars, terminés',
  'Un reporting chaque soir : vous voyez ce qui avance',
  'Valeur de la semaine : 500 €. Vous payez 0 €',
];

const etapes = [
  {
    n: 'Jour 0',
    t: 'On cadre',
    d: 'Vous créez votre espace client en 2 minutes, puis on se cale 30 minutes en visio : vous sortez vos 3 challenges, on les transforme en livrables datés. Un brief flou donne un livrable flou, alors on ne sort pas de cet appel tant que ce n\'est pas net.',
  },
  {
    n: 'Jours 1 à 5',
    t: 'Il travaille',
    d: '7 heures par jour sur vos projets. Vous n\'avez pas à le manager, à le relancer, ni à lui expliquer Claude : c\'est mon travail, pas le vôtre.',
  },
  {
    n: 'Chaque soir',
    t: 'Vous lisez',
    d: 'Le reporting se met à jour tout seul. Ce qui a été fait, ce qui bloque, ce qui arrive demain. Vous intervenez seulement si quelque chose part de travers.',
  },
  {
    n: 'Jour 5',
    t: 'Vous récupérez',
    d: 'Les livrables, le récapitulatif de la semaine, et la liste honnête de ce qui reste à faire. Puis vous filmez vos 2 minutes, dans les 30 jours.',
  },
];

const stack = [
  {
    item: 'Un consultant formé à l\'IA',
    detail: 'Opérationnel sur Claude Code et Claude Cowork, formé en interne avant d\'arriver chez vous.',
    value: '250 €',
  },
  {
    item: '5 jours ouvrés, 7 heures par jour',
    detail: '35 heures de travail réel sur vos projets. Chronométrées.',
    value: 'inclus',
  },
  {
    item: 'Jusqu\'à 3 challenges concrets',
    detail: 'Cadrés avec vous avant le jour 1, livrés avant le jour 5.',
    value: 'inclus',
  },
  {
    item: 'Une licence Claude additionnelle',
    detail:
      'Le consultant arrive avec son propre abonnement Claude Max 20x (environ 200 € par mois). Il ne consomme pas vos tokens : c\'est de la capacité en plus, pas la vôtre que l\'on grignote. Si vous saturez déjà votre abonnement Claude, c\'est la ligne qui vous intéresse.',
    value: '200 €',
  },
  {
    item: 'Un reporting quotidien en ligne',
    detail: 'reporting.claudeagency.fr : vous suivez l\'avancement sans réclamer.',
    value: '50 €',
  },
  {
    item: 'Un cerveau augmenté au sens propre',
    detail: 'Voir la section « Le secret industriel » juste au-dessus.',
    value: 'illégal ailleurs',
  },
];

const challenges = [
  {
    n: '01',
    titre: 'SEO & contenu',
    exemples: [
      'Audit SEO complet de votre site',
      'Une salve d\'articles optimisés, publiés',
      'Maillage interne remis à plat',
      'Être cité par ChatGPT et Google AI Overviews',
    ],
  },
  {
    n: '02',
    titre: 'Automatisation & IA',
    exemples: [
      'Un agent IA branché sur vos outils',
      'Vos tâches répétitives automatisées',
      'Un reporting qui se remplit tout seul',
      'Vos process documentés (enfin)',
    ],
  },
  {
    n: '03',
    titre: 'Prospection & CRM',
    exemples: [
      'Une liste de prospects qualifiés, propre',
      'Une séquence de mails froids qui ne finit pas en spam',
      'Votre CRM rangé et configuré',
      'Vos leads enrichis automatiquement',
    ],
  },
  {
    n: '04',
    titre: 'Web & données',
    exemples: [
      'Une landing page qui convertit',
      'Un dashboard qui dit la vérité',
      'Vos données nettoyées et structurées',
      'Les bugs que vous repoussez depuis mars',
    ],
  },
];

const faq = [
  {
    q: 'C\'est vraiment gratuit ?',
    r: 'Oui. Pas de carte bancaire, pas d\'abonnement qui se réactive tout seul au bout de 14 jours, pas de « et si vous passiez à l\'offre Premium ». Vous me devez une vidéo et 5 étoiles. Point.',
  },
  {
    q: 'Pourquoi tu fais ça ?',
    r: 'Parce qu\'un bon témoignage client vidéo me rapporte plus que 500 € de prestation. Et parce que rien ne nous empêche de continuer ensemble après : ce sera alors 500 € la semaine, et là ce ne sera plus gratuit. Le principe tient en une phrase : testez-moi gratuitement pendant une semaine, on va vous apporter tellement de valeur que vous allez nous supplier de prendre votre argent.',
  },
  {
    q: 'Et si le résultat est nul, je dois quand même mettre 5 étoiles ?',
    r: 'Non. Si c\'est nul, vous me le dites en face, vous ne mettez rien, et je vous offre une deuxième semaine pour me racheter. Un avis acheté se voit à trois kilomètres, ça ne m\'intéresse pas.',
  },
  {
    q: 'Je peux garder le consultant après ?',
    r: 'Oui, mais à partir du jour 6 il redevient payant : 500 € la semaine. Et il faut négocier avec moi, pas avec lui : il dira oui à tout, c\'est un des effets secondaires.',
  },
  {
    q: 'Ils sont vraiment dopés à la cocaïne ?',
    r: 'Ils sniffent de la poudre de riz. Je n\'ai pas encore le budget pour leur payer de la vraie cocaïne, mais c\'est un projet à l\'étude.',
  },
  {
    q: 'Bon, c\'est quoi le piège ?',
    r: 'Le piège, c\'est que si la semaine se passe bien, vous allez avoir envie de continuer. Et là, je facture. C\'est tout le modèle : je parie 35 heures sur le fait que vous serez content.',
  },
  {
    q: 'Je ne suis pas vraiment ton ami, je peux quand même ?',
    r: 'Techniquement non. Écrivez quand même, on verra bien.',
  },
];

const regles = [
  '5 jours ouvrés. Pas 5 jours + le week-end + « juste un petit truc lundi ».',
  '7 heures par jour maximum. Pour que ce soit plus clair : au-delà, la puce Neuralink de mes ingénieurs chauffe.',
  '3 challenges maximum. Un quatrième challenge, c\'est une deuxième semaine.',
  'Les challenges sont cadrés ensemble avant le jour 1. Un brief flou donne un livrable flou.',
  'Le consultant travaille sur vos projets, pas sur ceux de votre beau-frère.',
  'Une semaine par ami. Vous n\'avez pas 6 identités.',
  '4 places au total, jusqu\'au 30 septembre 2026. Premier arrivé, premier servi.',
  'Le témoignage vidéo se livre dans les 30 jours après la fin de la semaine. Passé ce délai, je vous relance, et je relance mal.',
];

const reporting = [
  { t: '09:02', l: 'Jour 3 · challenge 02 · automatisation', s: 'en cours' },
  { t: '09:02', l: 'Agent de relance branché sur le CRM', s: 'fait' },
  { t: '13:40', l: 'Import des 1 240 contacts, doublons purgés', s: 'fait' },
  { t: '17:55', l: 'Blocage : accès API en attente de votre clé', s: 'bloqué' },
  { t: '18:00', l: 'Demain : séquence de relance J+3 et J+7', s: 'prévu' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBF7F1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/semaine-offerte/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/semaine-offerte/`} />
    <meta property="og:image" content={`${site}/og-default.jpg`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Claude Agency" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-schibsted" preload />
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18240137840"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18240137840');
      gtag('config', 'G-6SG03DR5J9');
    </script>
    <style is:inline>
      :root {
        --cream: #fbf7f1;
        --cream-2: #f5efe6;
        --white: #ffffff;
        --sand: #e5d9c7;
        --sand-soft: #efe6d8;
        --ink: #2b2724;
        --body: #4a423b;
        --muted: #7a6e60;
        --accent: #cc785c;
        --accent-600: #b5634a;
        --accent-700: #934e3a;
        --accent-050: #faf0eb;
        --night: #14100e;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        --display: var(--font-bricolage), system-ui, sans-serif;
        --sans: var(--font-schibsted), system-ui, -apple-system, sans-serif;
        --shadow-card: 0 1px 2px rgba(43, 39, 36, 0.04), 0 14px 34px -22px rgba(43, 39, 36, 0.35);
        --shadow-frame: 0 2px 6px rgba(43, 39, 36, 0.06), 0 34px 70px -34px rgba(43, 39, 36, 0.42);
        --section: 84px;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; overflow-x: hidden; }

      body {
        margin: 0;
        background: var(--cream);
        color: var(--body);
        font-family: var(--sans);
        font-size: 17px;
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; }

      .wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 24px; }
      .narrow { max-width: 780px; }

      section { position: relative; padding: var(--section) 0; overflow: hidden; }
      .alt { background: var(--cream-2); }
      .hairline-top { border-top: 1px solid var(--sand); }

      /* ---------- décor ---------- */
      .grid-bg {
        position: absolute; inset: 0;
        background-image:
          linear-gradient(rgba(43, 39, 36, 0.055) 1px, transparent 1px),
          linear-gradient(90deg, rgba(43, 39, 36, 0.055) 1px, transparent 1px);
        background-size: 72px 72px;
        mask-image: radial-gradient(ellipse 70% 55% at 70% 0%, #000 10%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 70% 55% at 70% 0%, #000 10%, transparent 70%);
        pointer-events: none;
      }
      .aura {
        position: absolute; border-radius: 9999px; filter: blur(80px); pointer-events: none;
      }
      .aura-a { width: 460px; height: 360px; top: -120px; right: -80px; background: rgba(204, 120, 92, 0.28); }
      .aura-b { width: 380px; height: 320px; bottom: -160px; left: -120px; background: rgba(224, 160, 132, 0.22); }

      /* ---------- header ---------- */
      header.nav {
        position: sticky; top: 0; z-index: 40;
        background: rgba(251, 247, 241, 0.82);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--sand);
      }
      .nav-inner { height: 62px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      .brand {
        display: flex; align-items: center; gap: 10px; text-decoration: none;
        color: var(--ink); font-family: var(--display); font-weight: 700; font-size: 17px;
        letter-spacing: -0.3px; white-space: nowrap;
      }
      .brand img { width: 22px; height: 22px; }
      .nav-cta {
        font-size: 14px; font-weight: 600; text-decoration: none; color: #fff;
        background: var(--accent); border-radius: 9999px; padding: 9px 18px; white-space: nowrap;
        transition: background-color 160ms ease;
      }
      .nav-cta:hover { background: var(--accent-600); }

      /* ---------- typographie ---------- */
      h1, h2, h3 { color: var(--ink); margin: 0; font-family: var(--display); text-wrap: balance; }
      h1 { font-size: clamp(24px, 3.1vw, 36px); font-weight: 800; line-height: 1.12; letter-spacing: -0.9px; }
      h2 { font-size: clamp(24px, 2.8vw, 32px); font-weight: 700; line-height: 1.18; letter-spacing: -0.7px; }
      h3 { font-size: 20px; font-weight: 700; line-height: 1.3; letter-spacing: -0.3px; }
      p { margin: 0; }
      .lead { font-size: 18px; color: var(--body); }
      strong { color: var(--ink); font-weight: 600; }

      .kicker {
        display: inline-flex; align-items: center; gap: 9px;
        font-family: var(--mono); font-size: 11px; font-weight: 600;
        letter-spacing: 1.4px; text-transform: uppercase; color: var(--accent-700);
      }
      .kicker::before {
        content: ''; width: 6px; height: 6px; border-radius: 9999px; background: var(--accent);
      }

      .pill {
        display: inline-flex; align-items: center; gap: 9px;
        font-family: var(--mono); font-size: 12px; color: var(--accent-700);
        background: var(--accent-050); border: 1px solid #ecd6cb;
        border-radius: 9999px; padding: 6px 14px;
      }
      .pill .dot { width: 7px; height: 7px; border-radius: 9999px; background: var(--accent); }

      /* ---------- boutons ---------- */
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 16px; font-weight: 600; text-decoration: none; border-radius: 9999px;
        padding: 13px 26px;
        transition: transform 160ms ease, box-shadow 200ms ease, background-color 160ms ease;
      }
      .btn-primary {
        color: #fff; background: var(--accent);
        box-shadow: 0 10px 26px -12px rgba(147, 78, 58, 0.85);
      }
      .btn-primary:hover { background: var(--accent-600); transform: translateY(-1px); }
      .btn-ghost { color: var(--ink); border: 1px solid var(--sand); background: var(--white); }
      .btn-ghost:hover { border-color: #d5c4ad; }
      .btn:focus-visible { outline: 2px solid var(--accent-700); outline-offset: 3px; }

      /* ---------- cartes ---------- */
      .card {
        background: var(--white); border: 1px solid var(--sand); border-radius: 16px; padding: 26px;
        box-shadow: var(--shadow-card);
      }
      .card-hl { transition: transform 200ms ease, box-shadow 200ms ease; }
      .card-hl:hover { transform: translateY(-2px); box-shadow: 0 2px 6px rgba(43,39,36,.06), 0 22px 44px -24px rgba(43,39,36,.45); }

      .frame {
        border-radius: 18px; border: 1px solid var(--sand); background: var(--white);
        padding: 8px; box-shadow: var(--shadow-frame);
      }
      .frame img { display: block; width: 100%; height: auto; border-radius: 12px; }
      .frame-bar { display: flex; gap: 6px; padding: 6px 8px 10px; }
      .frame-bar i { width: 9px; height: 9px; border-radius: 9999px; background: var(--sand); display: block; }

      /* ---------- listes ---------- */
      ul.clean { list-style: none; margin: 0; padding: 0; }
      .tick { display: flex; gap: 12px; align-items: flex-start; padding: 6px 0; }
      .tick span.m {
        margin-top: 10px; width: 6px; height: 6px; flex: 0 0 auto; border-radius: 9999px; background: var(--accent);
      }

      .row {
        display: flex; align-items: flex-start; justify-content: space-between; gap: 28px;
        padding: 20px 0; border-bottom: 1px solid var(--sand);
      }
      .row:first-child { border-top: 1px solid var(--sand); }
      .row .v { font-family: var(--mono); font-size: 13px; color: var(--accent-700); white-space: nowrap; padding-top: 5px; }
      .row .t { color: var(--ink); font-weight: 600; }
      .row .d { color: var(--muted); font-size: 15.5px; margin-top: 3px; }

      /* ---------- terminal (contraste sombre volontaire) ---------- */
      .term {
        background: var(--night); border-radius: 14px; font-family: var(--mono); font-size: 13px;
        overflow: hidden; box-shadow: var(--shadow-frame);
      }
      .term-head {
        display: flex; align-items: center; gap: 9px; padding: 12px 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #b9aca1; font-size: 12px;
      }
      .term-head .dot { width: 7px; height: 7px; border-radius: 9999px; background: var(--accent); display: block; }
      .term-body { padding: 14px; display: grid; gap: 10px; }
      .term-line { display: grid; grid-template-columns: 52px 1fr auto; gap: 12px; align-items: baseline; }
      .term-line .tm { color: #8a7d73; }
      .term-line .tx { color: #f0e8e2; }
      .tag { font-size: 11px; letter-spacing: 0.5px; text-transform: uppercase; padding: 2px 8px; border-radius: 9999px; }
      .tag.fait { color: #7fd6ac; background: rgba(127, 214, 172, 0.14); }
      .tag.encours { color: #e8a888; background: rgba(232, 168, 136, 0.16); }
      .tag.bloque { color: #ff9d9d; background: rgba(255, 157, 157, 0.14); }
      .tag.prevu { color: #a8c6e8; background: rgba(168, 198, 232, 0.14); }

      /* ---------- prix ---------- */
      .price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px; margin-top: 30px; }
      .price .old { font-family: var(--mono); font-size: 22px; color: var(--muted); text-decoration: line-through; text-decoration-color: var(--accent); }
      .price .new {
        font-family: var(--display); font-size: clamp(42px, 6.5vw, 66px); font-weight: 800;
        letter-spacing: -2px; line-height: 1; color: var(--accent-700);
      }

      /* ---------- bandeau contrepartie ---------- */
      .band {
        background:
          radial-gradient(110% 100% at 0% 0%, rgba(224, 160, 132, 0.35) 0%, transparent 55%),
          linear-gradient(135deg, var(--accent-700) 0%, #7a4030 60%, #5c3024 100%);
      }
      .band h2, .band h3 { color: #fff; }
      .band .kicker { color: #f3d6c9; }
      .band .kicker::before { background: #f3d6c9; }
      .band p { color: #f2e2da; }
      .band .num { font-family: var(--mono); font-size: 24px; color: #f3c4ae; line-height: 1.1; }

      /* ---------- grilles ---------- */
      .split { display: grid; gap: 40px; align-items: start; }
      .cards-2 { display: grid; gap: 20px; }
      @media (min-width: 860px) {
        .split { grid-template-columns: 1fr 1fr; gap: 56px; }
        .split.centered { align-items: center; }
        .cards-2 { grid-template-columns: 1fr 1fr; }
      }

      /* ---------- FAQ ---------- */
      details.q { border-bottom: 1px solid var(--sand); padding: 18px 0; }
      details.q summary {
        cursor: pointer; list-style: none; color: var(--ink); font-weight: 600;
        display: flex; align-items: flex-start; justify-content: space-between; gap: 20px;
      }
      details.q summary::-webkit-details-marker { display: none; }
      details.q summary::after {
        content: '+'; font-family: var(--mono); color: var(--accent); font-size: 20px; line-height: 1;
        transition: transform 200ms ease;
      }
      details.q[open] summary::after { transform: rotate(45deg); }
      details.q p { margin-top: 10px; color: var(--muted); max-width: 68ch; }

      /* ---------- footer ---------- */
      footer.ft { border-top: 1px solid var(--sand); padding: 36px 0 52px; color: var(--muted); font-size: 13.5px; }
      footer.ft a { color: var(--accent-700); }

      /* ---------- reveal (progressive enhancement) ---------- */
      .js .rv { opacity: 0; transform: translateY(16px); transition: opacity 650ms ease-out, transform 650ms ease-out; }
      .js .rv.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .js .rv { opacity: 1; transform: none; transition: none; }
        html { scroll-behavior: auto; }
        .btn, .card-hl { transition: none; }
      }

      .skip { position: absolute; left: -9999px; }
      .skip:focus {
        left: 16px; top: 16px; z-index: 60; position: fixed;
        background: var(--accent); color: #fff; padding: 10px 16px; border-radius: 8px;
      }

      @media (max-width: 520px) {
        :root { --section: 64px; }
        .nav-cta { font-size: 13px; padding: 8px 14px; }
        .pill { font-size: 11px; padding: 6px 12px; }
        body { font-size: 16px; }
      }
    </style>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip" href="#main">Aller au contenu</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="22" height="22" />
          Claude Agency
        </a>
        <a class="nav-cta" href={CTA_URL}>Réserver ma semaine</a>
      </div>
    </header>

    <main id="main">
      <!-- HERO -->
      <section style="padding-top:44px;padding-bottom:64px;">
        <div class="grid-bg"></div>
        <div class="aura aura-a"></div>
        <div class="wrap" style="position:relative;">
          <span class="pill rv"><span class="dot"></span>4 places · jusqu'au 30 septembre 2026</span>

          <div class="split" style="margin-top:20px;">
            <div class="rv">
              <h1>Je vous prête un consultant IA augmenté pendant 1 semaine. Vous ne payez rien.</h1>
              <p class="lead" style="margin-top:18px;">
                5 jours ouvrés, 3 challenges de votre choix, un reporting tous les soirs. Votre part du marché :
                une vidéo de 2 minutes et 5 étoiles sur Google.
              </p>
              <ul class="clean" style="margin-top:18px;">
                {heroPoints.map((p) => (
                  <li class="tick"><span class="m"></span><span>{p}</span></li>
                ))}
              </ul>
            </div>

            <div class="rv">
              <div class="frame">
                <div class="frame-bar"><i></i><i></i><i></i></div>
                <Image
                  src={heroImg}
