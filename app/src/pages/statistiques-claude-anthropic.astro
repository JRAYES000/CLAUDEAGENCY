---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import chiffresImg from '../assets/hero-pilotage-ia.jpg';

const site = Astro.site!;

// Page de reprise trimestrielle. Chaque chiffre ci-dessous porte sa source dans le
// tableau qui l'affiche : quand une source publie un chiffre plus recent, on remplace
// la ligne ET on bouge `maj` et `releveDu`. Une page de statistiques qui date perd
// exactement ce qu'elle est censee gagner.
const releveDu = '15 septembre 2026';
// Les sources sur les limites d'usage ont ete rouvertes le 17/09, les autres non :
// une seule date pour toute la page mentirait sur ce qui a ete revu.
const releveLimites = '17 septembre 2026';
// Le releve d'audience est notre seule donnee propre : il se refait en entier, cabinet
// par cabinet, et porte donc sa propre date. Detail des lectures :
// visibilite-ops, recherche/2026-09-17-audience-claude-par-cabinet.md
const releveAudience = '17 septembre 2026';
const publie = '2026-09-13';
const maj = '2026-09-17';

const argent = [
  {
    quoi: 'Valorisation',
    valeur: '965 milliards de dollars (post-money)',
    source: 'Anthropic, annonce de la Série H, 28 mai 2026',
    url: 'https://www.anthropic.com/news/series-h',
  },
  {
    quoi: 'Dernière levée de fonds',
    valeur: '65 milliards de dollars (Série H)',
    source: 'Anthropic, 28 mai 2026',
    url: 'https://www.anthropic.com/news/series-h',
  },
  {
    quoi: 'Revenu annualisé, mai 2026',
    valeur: '47 milliards de dollars',
    source: 'Anthropic, 28 mai 2026',
    url: 'https://www.anthropic.com/news/series-h',
  },
  {
    quoi: 'Revenu annualisé, fin juillet 2026',
    valeur: '65 milliards de dollars',
    source: 'Bloomberg, repris par TechCrunch le 17 août 2026',
    url: 'https://techcrunch.com/2026/08/17/anthropics-annualized-revenue-surges-to-65b/',
  },
  {
    quoi: 'Revenu annualisé, fin 2025',
    valeur: '9 milliards de dollars',
    source: 'TechCrunch, 17 août 2026',
    url: 'https://techcrunch.com/2026/08/17/anthropics-annualized-revenue-surges-to-65b/',
  },
  {
    quoi: 'Revenu annualisé attendu fin 2026',
    valeur: 'entre 100 et 120 milliards de dollars',
    source: 'Financial Times, cité par TechCrunch le 17 août 2026',
    url: 'https://techcrunch.com/2026/08/17/anthropics-annualized-revenue-surges-to-65b/',
  },
];

const parts = [
  { fournisseur: 'Anthropic', api: '40 %', code: '54 %' },
  { fournisseur: 'OpenAI', api: '27 %', code: '21 %' },
  { fournisseur: 'Google', api: '21 %', code: 'non communiqué' },
  { fournisseur: 'Autres fournisseurs', api: '12 %', code: 'non communiqué' },
];

const abonnements = [
  { plan: 'Gratuit', prix: '0 $' },
  { plan: 'Pro', prix: '17 $ par mois en paiement annuel, 20 $ au mois' },
  { plan: 'Max', prix: 'à partir de 100 $ par mois' },
  { plan: 'Team', prix: '20 $ par personne et par mois en annuel, 25 $ au mois' },
  { plan: 'Team Premium', prix: '100 $ par personne et par mois en annuel, 125 $ au mois' },
  { plan: 'Entreprise', prix: '20 $ par personne, plus la consommation' },
];

const limites = [
  {
    plan: 'Gratuit',
    publie: "Aucun chiffre. Anthropic indique seulement que le Pro donne plus d'usage par session que le gratuit.",
  },
  {
    plan: 'Pro',
    publie: "Une limite de session remise à zéro toutes les cinq heures, plus une limite hebdomadaire qui vaut pour tous les modèles. Aucun nombre de messages.",
  },
  {
    plan: 'Max 5×',
    publie: "Cinq fois l'usage par session du Pro. Mêmes fenêtres de cinq heures et hebdomadaire.",
  },
  {
    plan: 'Max 20×',
    publie: "Vingt fois l'usage par session du Pro. Mêmes fenêtres.",
  },
  {
    plan: 'Team et Entreprise par siège',
    publie: "Mêmes fenêtres. Concernés par la hausse du 14 septembre 2026 sur Claude Code.",
  },
];

// Notre propre relevé : personne ne publie ces quatre périmètres côte à côte, et c'est
// le périmètre — pas le nombre — qui explique pourquoi les chiffres qui circulent ne
// sont pas comparables. Chaque source a été ouverte le 17/09/2026.
const audience = [
  {
    cabinet: 'Anthropic',
    url: null,
    mesure: 'Ses propres produits.',
    publie: "Aucun nombre d'utilisateurs dans ses annonces publiques.",
  },
  {
    cabinet: 'Sensor Tower',
    url: 'https://sensortower.com/blog/state-of-ai-2026',
    mesure: "Son indicateur « True Audience » : application mobile et site web réunis. La part de marché, elle, ne porte que sur les États-Unis.",
    publie: "Audience en hausse de 452 % sur un an en mai 2026, et part américaine passée de 4,4 % à près de 14 %. Aucun nombre absolu d'utilisateurs.",
  },
  {
    cabinet: 'Similarweb',
    url: 'https://www.similarweb.com/website/claude.ai/',
    mesure: "Les visites estimées du site claude.ai dans le monde. Ni l'application mobile, ni l'usage par l'API — et une visite n'est pas une personne.",
    publie: '« Total Visits Last 3 Months » : 950,2 millions sur les données d\'août 2026, en baisse de 1,97 % sur un mois.',
  },
  {
    cabinet: 'Yipit Data, cité par a16z',
    url: 'https://a16z.com/100-gen-ai-apps-6/',
    mesure: 'Les abonnés payants américains.',
    publie: 'Croissance de plus de 200 % sur un an en janvier 2026. ChatGPT reste 8 fois plus gros sur cette seule mesure.',
  },
];

const modeles = [
  { nom: 'Claude Fable 5.1', contexte: '1 million de jetons', sortie: '128 000 jetons', entree: '10 $', sortiePrix: '50 $' },
  { nom: 'Claude Opus 5', contexte: '1 million de jetons', sortie: '128 000 jetons', entree: '5 $', sortiePrix: '25 $' },
  { nom: 'Claude Sonnet 5', contexte: '1 million de jetons', sortie: '128 000 jetons', entree: '2 $', sortiePrix: '10 $' },
  { nom: 'Claude Haiku 4.5', contexte: '200 000 jetons', sortie: '64 000 jetons', entree: '1 $', sortiePrix: '5 $' },
];

const webPage = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  '@id': new URL('/statistiques-claude-anthropic/', site).href,
  url: new URL('/statistiques-claude-anthropic/', site).href,
  name: 'Statistiques Claude et Anthropic : les chiffres 2026',
  description:
    "Les chiffres publics de Claude et d'Anthropic en 2026 : valorisation, revenu annualisé, part de marché en entreprise, tarifs, modèles et limites d'usage, chacun avec sa source et sa date.",
  isPartOf: { '@id': new URL('/#website', site).href },
  publisher: { '@id': new URL('/#organization', site).href },
  datePublished: publie,
  dateModified: maj,
  inLanguage: 'fr-FR',
};
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Statistiques Claude et Anthropic' },
  ],
};
const dateFr = (iso: string) => new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title="Statistiques Claude et Anthropic : les chiffres 2026"
  description="Les chiffres publics de Claude et d'Anthropic en 2026 : valorisation, revenu, part de marché, tarifs et limites d'usage. Chaque ligne porte sa source."
  image={chiffresImg.src}
  imageAlt="Dirigeant à son bureau, entouré de tableaux de chiffres et de courbes de performance"
  pageSchema={[webPage, breadcrumb]}
>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <div class="cp-rise">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Chiffres &amp; sources</p>
      <h1 class="mt-3 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-5xl">Statistiques Claude et Anthropic&nbsp;: les chiffres de 2026</h1>
      <p class="mt-4 text-sm text-muted">Publié le {dateFr(publie)}<span aria-hidden="true"> · </span>Mis à jour le <time datetime={maj}>{dateFr(maj)}</time><span aria-hidden="true"> · </span>Sources revérifiées le {releveDu}</p>
    </div>

    <div class="prose prose-stone mt-8 max-w-none">
      <p class="lead">
        Au {releveDu}, les <strong>statistiques Claude et Anthropic</strong> publiques tiennent
        en quatre chiffres&nbsp;: Anthropic vaut <strong>965 milliards de dollars</strong> après une
        levée de 65 milliards annoncée le 28 mai 2026, son revenu annualisé atteignait
        <strong>65 milliards de dollars</strong> fin juillet 2026, le cabinet Menlo Ventures estimait
        sa part à <strong>40&nbsp;% des dépenses en API de modèles de langage</strong> des 495 décideurs
        américains qu'il a interrogés en novembre 2025, et l'abonnement Claude Pro
        coûte <strong>17 dollars par mois</strong> en paiement annuel. Chaque ligne de cette page porte
        sa source d'origine et la date à laquelle elle a été publiée. Ce qui n'a pas de source
        publique n'y figure pas&nbsp;— et nous le disons quand c'est le cas.
      </p>

      <h2>Combien vaut Anthropic et combien gagne-t-elle&nbsp;?</h2>
      <p>
        Anthropic est une société non cotée&nbsp;: elle ne publie pas de comptes. Les seuls chiffres
        financiers fiables viennent donc de ses propres annonces et des dépêches de presse qui les
        complètent. Les voici, dans l'ordre où ils ont été rendus publics.
      </p>
      <table>
        <caption class="text-left text-sm text-muted">Anthropic — chiffres financiers publics, relevés le {releveDu}</caption>
        <thead>
          <tr><th>Donnée</th><th>Valeur</th><th>Source et date de publication</th></tr>
        </thead>
        <tbody>
          {argent.map((l) => (
            <tr>
              <td>{l.quoi}</td>
              <td>{l.valeur}</td>
              <td><a href={l.url} rel="nofollow">{l.source}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>
        Deux précautions pour qui reprend ces chiffres. Le <em>revenu annualisé</em> n'est pas un
        chiffre d'affaires&nbsp;: c'est le revenu du dernier mois multiplié par douze, une mesure qui
        gonfle vite quand la croissance est forte et qui ne dit rien de la rentabilité. Et la
        prévision de 100 à 120 milliards pour fin 2026 est une <strong>attente d'investisseurs
        rapportée par la presse</strong>, pas un engagement d'Anthropic.
      </p>

      <h2>Quelle est la part de marché de Claude face à ChatGPT&nbsp;?</h2>
      <p>
        Sur la dépense des entreprises en API, Anthropic est passé devant OpenAI fin 2025. Le chiffre
        de référence n'est pas une mesure mais une <strong>estimation</strong>&nbsp;: celle de l'enquête
        annuelle de Menlo Ventures, menée auprès de <strong>495 décideurs américains du
        7 au 25 novembre 2025</strong> et publiée le <strong>9 décembre 2025</strong>. Le cabinet écrit
        lui-même «&nbsp;<em>we estimate</em>&nbsp;». Elle porte sur
        la dépense en API, c'est-à-dire l'usage professionnel des modèles dans des produits et des
        outils internes&nbsp;— pas sur le nombre de gens qui ouvrent une application de discussion.
      </p>
      <table>
        <caption class="text-left text-sm text-muted">Part des dépenses des entreprises en API de modèles de langage — <a href="https://menlovc.com/perspective/2025-the-state-of-generative-ai-in-the-enterprise/" rel="nofollow">Menlo Ventures, 9 décembre 2025</a></caption>
        <thead>
          <tr><th>Fournisseur</th><th>Toutes catégories</th><th>Génération de code</th></tr>
        </thead>
        <tbody>
          {parts.map((p) => (
            <tr><td>{p.fournisseur}</td><td>{p.api}</td><td>{p.code}</td></tr>
          ))}
        </tbody>
      </table>
      <p>
        Deux renversements dans ces chiffres. La part d'OpenAI est tombée de 50&nbsp;% en 2023 à
        27&nbsp;%, quand celle d'Anthropic est montée de 24&nbsp;% en 2024 à 40&nbsp;%. Et sur la
        génération de code, Anthropic tient à elle seule plus de la moitié de cette même dépense
        en API — 54&nbsp;% estimés, toujours sur le périmètre de l'enquête. La même
        enquête chiffre la dépense totale des entreprises en IA générative à <strong>37 milliards de
        dollars sur 2025</strong>, contre 11,5 milliards en 2024.
      </p>
    </div>

    <Image
      src={chiffresImg}
      alt="Dirigeant à son bureau, entouré de tableaux de chiffres et de courbes de performance"
      loading="lazy"
      sizes="(min-width: 768px) 42rem, 100vw"
      class="mt-10 w-full rounded-2xl border border-sand object-cover"
    />

    <div class="prose prose-stone mt-10 max-w-none">
      <h2>Combien d'utilisateurs Claude a-t-il&nbsp;?</h2>
      <p>
        <strong>Anthropic ne publie aucun chiffre d'utilisateurs, et nous n'avons trouvé aucune
        publication d'origine qui en donne un.</strong> C'est la réponse exacte, et c'est celle qui
        manque partout ailleurs. Les nombres qui circulent viennent de cabinets de mesure d'audience
        extérieurs, avec des périmètres différents&nbsp;: application mobile seule, site web seul, les
        deux, avec ou sans les usages passés par l'API. Aucun d'eux ne vient d'Anthropic, et aucun
        n'est comparable à un autre.
      </p>
      <p>
        Ce que nous publions à la place, et que nous n'avons vu nulle part ailleurs&nbsp;: <strong>ce que
        chaque cabinet mesure réellement</strong>, en face de ce qu'il publie sur Claude. Quatre
        périmètres différents, donc quatre chiffres qui ne s'additionnent pas et ne se comparent pas.
        Nous avons ouvert chacune de ces sources le {releveAudience}.
      </p>
      <table>
        <caption class="text-left text-sm text-muted">Les chiffres d'audience de Claude, cabinet par cabinet et périmètre par périmètre — relevé Claude Agency du {releveAudience}</caption>
        <thead>
          <tr><th>Cabinet</th><th>Ce qu'il mesure</th><th>Ce qu'il publie sur Claude</th></tr>
        </thead>
        <tbody>
          {audience.map((a) => (
            <tr>
              <td>{a.url ? <a href={a.url}>{a.cabinet}</a> : a.cabinet}</td>
              <td>{a.mesure}</td>
              <td>{a.publie}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>
        Le nombre le plus repris — <strong>245 millions d'utilisateurs mensuels</strong> — est attribué
        au rapport <em>State of AI 2026</em> de Sensor Tower. Nous avons ouvert cette publication le
        {' '}{releveAudience}&nbsp;: <strong>elle ne contient aucun nombre d'utilisateurs</strong>. Nous ne le
        reprenons donc pas. Même mécanique probable pour les «&nbsp;952 millions de visites mensuelles&nbsp;»
        qu'on lit chez les agrégateurs&nbsp;: c'est l'ordre de grandeur du total de Similarweb <strong>sur
        trois mois</strong>, relu comme un total mensuel.
      </p>
      <p>
        Si vous devez citer un chiffre d'audience, citez la source de mesure et son périmètre, pas
        Anthropic. Ce qui est officiel, en revanche&nbsp;: le 28 mai 2026, Anthropic a indiqué que
        Claude était <strong>le premier modèle de pointe disponible sur les trois plus grandes
        plateformes de cloud</strong> — Amazon Web Services, Google Cloud et Microsoft Azure.
      </p>

      <h2>Combien coûte Claude&nbsp;?</h2>
      <p>
        Les tarifs ci-dessous sont ceux affichés par Anthropic le {releveDu}, en dollars américains.
        Ils changent régulièrement&nbsp;: la page officielle fait foi.
      </p>
      <table>
        <caption class="text-left text-sm text-muted">Abonnements Claude — <a href="https://claude.com/pricing" rel="nofollow">page tarifs d'Anthropic</a>, relevée le {releveDu}</caption>
        <thead>
          <tr><th>Formule</th><th>Prix affiché</th></tr>
        </thead>
        <tbody>
          {abonnements.map((a) => (
            <tr><td>{a.plan}</td><td>{a.prix}</td></tr>
          ))}
        </tbody>
      </table>
      <p>
        Pour un usage par programme, Anthropic facture au million de jetons. Les requêtes groupées
        sont facturées <strong>moitié prix</strong>, et la relecture d'un contexte déjà mis en cache
        coûte <strong>10&nbsp;% du prix d'entrée</strong> — <strong>2,5&nbsp;% sur Claude Fable 5.1</strong>,
        soit 0,25&nbsp;$ le million de jetons au lieu de 1&nbsp;$, d'après la
        <a href="https://platform.claude.com/docs/en/about-claude/pricing">page tarifs de la documentation
        Anthropic</a> relue le {releveDu}. C'est le premier modèle du tableau ci-dessous&nbsp;: sur un
        agent qui relit beaucoup de contexte, appliquer les 10&nbsp;% sans l'exception multiplie le poste
        principal par quatre.
      </p>

      <h2>Quelles sont les limites d'usage de Claude&nbsp;?</h2>
      <p>
        <strong>Anthropic ne publie aucun nombre de messages ni aucun quota chiffré.</strong> Ce qu'elle
        publie, relevé le {releveLimites} sur ses pages d'aide&nbsp;: deux fenêtres qui se cumulent —&nbsp;une
        limite de session <strong>remise à zéro toutes les cinq heures</strong> et une <strong>limite
        hebdomadaire</strong> qui vaut pour tous les modèles&nbsp;— et le fait que Claude et Claude Code
        <strong>puisent dans la même réserve</strong>. Le seul chiffre daté est une variation&nbsp;: depuis le
        <strong>14 septembre 2026</strong>, les limites hebdomadaires de Claude Code sont
        <strong>25&nbsp;% plus hautes</strong> qu'avant mai 2026.
      </p>
      <table>
        <caption class="text-left text-sm text-muted">Ce qu'Anthropic publie sur les limites, formule par formule — pages d'aide <a href="https://support.claude.com/en/articles/8325606-what-is-the-pro-plan">Pro</a> et <a href="https://support.claude.com/en/articles/11049741-what-is-the-max-plan">Max</a>, relevées le {releveLimites}</caption>
        <thead>
          <tr><th>Formule</th><th>Ce qui est publié</th></tr>
        </thead>
        <tbody>
          {limites.map((l) => (
            <tr><td>{l.plan}</td><td>{l.publie}</td></tr>
          ))}
        </tbody>
      </table>
      <p>
        Les multiplicateurs Max portent sur l'<em>usage par session</em>, pas sur un nombre de messages&nbsp;:
        une conversation longue, un gros document ou un modèle plus puissant consomment davantage à nombre
        de messages égal. Anthropic ajoute, sur sa page Max&nbsp;: «&nbsp;<em>we may limit your usage in other
        ways, such as weekly and monthly caps or model and feature usage, at our discretion</em>&nbsp;».
        Aucune formule ne garantit donc un volume.
      </p>

      <h2>Qu'est-ce qui a changé le 14 septembre 2026&nbsp;?</h2>
      <p>
        Les limites hebdomadaires de Claude Code sont <strong>25&nbsp;% plus hautes</strong> qu'avant mai 2026
        pour les formules Pro, Max, Team et Entreprise par siège, de façon permanente. Mais elles sont
        <strong>17&nbsp;% plus basses que la veille</strong>&nbsp;: un bonus temporaire de 50&nbsp;%, actif depuis
        mai 2026, s'est arrêté le 13 septembre 2026 à 23&nbsp;h&nbsp;59 heure du Pacifique. Le niveau passe donc
        de 150 à 125 sur une base 100. Annonce faite le <strong>29 août 2026</strong> par
        <a href="https://x.com/ClaudeDevs/status/2093742321473065266">le compte Claude Developers d'Anthropic</a>.
      </p>
      <p>
        C'est la lecture qui manque partout&nbsp;: «&nbsp;+25&nbsp;%&nbsp;» et «&nbsp;−17&nbsp;%&nbsp;» décrivent le même
        changement, vus depuis deux points de départ différents. Anthropic a republié son annonce pour
        préciser elle-même la baisse par rapport au niveau d'alors, après des réactions de développeurs
        —&nbsp;épisode rapporté par <a href="https://www.bleepingcomputer.com/news/artificial-intelligence/anthropic-is-cutting-claude-codes-current-weekly-limits-by-17-percent/" rel="nofollow">BleepingComputer</a> et, en français, par le
        <a href="https://www.blogdumoderateur.com/claude-code-anthropic-releve-limites-hebdomadaires-25-pourcent/" rel="nofollow">Blog du Modérateur du 31 août 2026</a>. Si vous aviez pris un abonnement
        pendant l'été, votre volume utile a baissé&nbsp;; si vous arrivez maintenant, il a monté.
      </p>

      <h2>Que se passe-t-il quand on atteint la limite&nbsp;?</h2>
      <p>
        Claude prévient et s'arrête jusqu'à la remise à zéro suivante. Depuis le <strong>10 août 2026</strong>,
        les abonnés <strong>Pro, Max 5× et Max 20×</strong> peuvent activer des <em>crédits d'usage</em> pour
        continuer au-delà&nbsp;: la consommation supplémentaire est alors <strong>facturée aux tarifs API
        standard</strong>, avec un plafond de <strong>2&nbsp;000&nbsp;$ par jour</strong>, d'après la
        <a href="https://support.claude.com/en/articles/12429409-manage-usage-credits-for-paid-claude-plans">page d'aide d'Anthropic</a> relue le {releveLimites}. Les tarifs en
        question sont ceux du tableau des modèles ci-dessous. Pour savoir combien vous consommez, l'écran
        Réglages &gt; Usage affiche les deux jauges, celle des cinq heures et celle de la semaine.
      </p>
      <p>
        En pratique, ce qui fait tomber une limite plus tôt n'est presque jamais le nombre de messages&nbsp;:
        c'est une conversation qu'on laisse grossir toute la journée, puisque tout son contenu est relu à
        chaque tour. Nous en avons fait une
        <a href="/evaluation-claude-code/">évaluation de 20 situations réelles</a>, dont celle-là.
      </p>
      <h2>Quels sont les modèles Claude disponibles en 2026&nbsp;?</h2>
      <table>
        <caption class="text-left text-sm text-muted">Modèles Claude en service — <a href="https://platform.claude.com/docs/en/about-claude/models/overview" rel="nofollow">documentation Anthropic</a>, relevée le {releveDu}</caption>
        <thead>
          <tr><th>Modèle</th><th>Mémoire de travail</th><th>Réponse maximale</th><th>Prix par million de jetons</th></tr>
        </thead>
        <tbody>
          {modeles.map((m) => (
            <tr>
              <td>{m.nom}</td>
              <td>{m.contexte}</td>
              <td>{m.sortie}</td>
              <td>{m.entree} en entrée, {m.sortiePrix} en sortie</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>
        Un million de jetons représente environ <strong>555 000 mots</strong> sur les trois modèles à
        un million ci-dessus, soit à peu près six romans&nbsp;: c'est ce que le modèle peut lire en une
        fois. Le décompte a changé avec Claude Opus 4.7&nbsp;; les modèles antérieurs, dont Claude
        Haiku 4.5, font entrer <strong>environ 750 000 mots</strong> dans un million de jetons, et ses
        200 000 jetons valent donc environ 150 000 mots — chiffres de la
        <a href="https://platform.claude.com/docs/en/about-claude/models/overview">documentation Anthropic</a>,
        relue le {releveDu}. C'est la différence qui compte le
        plus en pratique entre les modèles, avant même la qualité des réponses. Ce que cela change
        pour une entreprise qui hésite entre les deux principaux assistants, nous l'avons détaillé
        dans notre comparatif <a href="/blog/claude-vs-chatgpt-organisme-formation/">Claude ou ChatGPT</a>.
      </p>

