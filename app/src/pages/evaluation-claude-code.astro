---
import BaseLayout from '../layouts/BaseLayout.astro';

// Évaluation interne des collaborateurs Claude Agency.
// Parcours question par question : 30 s pour répondre. Qui répond arrête le chrono et
// lit la correction sans limite de temps ; qui laisse filer les 30 s voit « Temps écoulé »
// et le test enchaîne seul sur la question suivante — la correction manquée est reprise
// sur l'écran de résultat. À la fin, le résultat part vers /api/evaluation,
// qui crée une ligne dans la base Notion « Resultats du test Claude Code ».
// Page utilitaire : absente du menu, mais indexable — regle de Julien du 23/08,
// aucune page des deux sites n'est en noindex.
// Corrigé sourcé sur la documentation officielle (champ `source`).

// Périmètre : l'usage courant de Claude Code. Chaque question se répond sans avoir lu
// de document interne — un candidat ou un nouvel arrivant peut le passer tel quel.
const DOMAINES = {
  demande: 'Formuler sa demande',
  contexte: 'Contexte et limite',
  session: 'Piloter une session',
  verif: 'Vérifier avant de livrer',
  methode: 'Méthode de travail',
};

// `min` porte desormais sur le score sur 100, pas sur le nombre de bonnes reponses.
// Seuils cales sur les anciens (17/20 et 12/20) a la duree mediane constatee le
// 04/09/2026 : les paliers deja enregistres sont inchanges. Ils sont repris a
// l'identique dans functions/api/evaluation.js, qui fait foi pour la base Notion.
const PALIERS = [
  {
    min: 75,
    titre: 'Autonome',
    ton: 'ok',
    texte: "Vous pouvez prendre une mission client de bout en bout. Ce qui fera la différence en clientèle, ce n'est plus la connaissance de l'outil, c'est la discipline de vérification.",
  },
  {
    min: 50,
    titre: 'Opérationnel sur cadrage',
    ton: 'moyen',
    texte: "Vous pouvez travailler sur un projet cadré et relu. Reprenez les questions manquées avant de démarrer : ce sont exactement les points où une erreur se paie chez le client.",
  },
  {
    min: 0,
    titre: 'À former avant de démarrer',
    ton: 'ko',
    texte: "Il manque des bases pour travailler sans aide. Priorité : une conversation par sujet et /clear quand vous changez, la façon de formuler une demande (exemples, documents en haut), et le réflexe de vérifier avant d'affirmer.",
  },
];

const questions = [
  // ============ Formuler sa demande ============
  {
    domaine: 'demande',
    q: "Vous lancez un travail de deux heures sur un projet client. Quelle phrase ajoutez-vous à votre demande pour éviter de découvrir à la fin qu'il est parti dans la mauvaise direction ?",
