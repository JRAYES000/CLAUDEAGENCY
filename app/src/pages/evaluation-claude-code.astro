---
import BaseLayout from '../layouts/BaseLayout.astro';

// Évaluation interne des collaborateurs Claude Agency.
// Parcours question par question : 30 s pour répondre. Qui répond arrête le chrono et
// lit la correction sans limite de temps ; qui laisse filer les 30 s voit « Temps écoulé »
// et le test enchaîne seul sur la question suivante — la correction manquée est reprise
// sur l'écran de résultat. À la fin, le résultat part vers /api/evaluation,
// qui crée une ligne dans la base Notion « Resultats du test Claude Code ».
// Page utilitaire : absente du menu, mais indexable — regle de Julien du 23/08,
// aucune page des deux sites n'est en noindex.
// Corrigé sourcé sur la documentation officielle (champ `source`).

// Périmètre : chaque question porte sur un point du guide interne
// « Bien utiliser Claude — le guide simple » (Notion). Rien d'autre.
const DOMAINES = {
  skills: "Skills d'équipe",
  contexte: 'Contexte et limite',
  demande: 'Formuler sa demande',
  verif: 'Vérifier avant de livrer',
  missions: 'Missions et parallélisation',
  methode: 'Méthode de travail',
};

const PALIERS = [
  {
    min: 17,
    titre: 'Autonome',
    ton: 'ok',
    texte: "Vous pouvez prendre une mission client de bout en bout. Ce qui fera la différence en clientèle, ce n'est plus la connaissance de l'outil, c'est la discipline de vérification.",
  },
  {
    min: 12,
    titre: 'Opérationnel sur cadrage',
    ton: 'moyen',
    texte: "Vous pouvez travailler sur un projet cadré et relu. Reprenez les questions manquées avant de démarrer : ce sont exactement les points où une erreur se paie chez le client.",
  },
  {
    min: 0,
    titre: 'À former avant de démarrer',
    ton: 'ko',
    texte: "Il manque des bases pour travailler sans aide. Priorité : une conversation par sujet et /clear quand vous changez, la façon de formuler une demande (exemples, documents en haut), et le réflexe de vérifier avant d'affirmer.",
  },
];

const questions = [
  // ============ Skills d'équipe (règle 1) ============
  {
    domaine: 'skills',
    q: "Vous démarrez une refonte de page pour un client, un travail délicat où vous voulez que Claude vous challenge. Un collègue vous conseille de lancer `/phrase-magique` et `/fonce` ensemble, « pour cumuler les deux ». Que faites-vous ?",
    opts: [
      "Les deux : la première cadre la demande, la seconde exécute jusqu'au bout",
      "`/fonce` seule, elle contient déjà une phase de cadrage",
      "`/phrase-magique` seule : `/fonce` interdit à Claude de poser la moindre question, elles font le contraire l'une de l'autre",
      "Ni l'une ni l'autre : les skills servent aux missions longues, pas aux travaux délicats",
    ],
    correct: 2,
    pourquoi: [
      "Elles ne se cumulent pas, elles s'annulent : l'une oblige Claude à vous questionner, l'autre le lui interdit.",
      "`/fonce` ne cadre rien. Elle exige que vous ayez cadré vous-même, dans votre demande, avant de la lancer.",
      "Exact. Travail délicat, `/phrase-magique`. Mission balisée que vous voulez voir finie sans vous, `/fonce`.",
      "Un travail délicat est précisément le cas d'usage de `/phrase-magique`.",
    ],
    explication: "C'est la seule incompatibilité explicite du guide. Le critère de choix tient en une question : voulez-vous être interrogé pendant le travail, ou partir et retrouver un résultat fini ?",
    source: null,
  },
  {
    domaine: 'skills',
    q: "Vous partez deux heures et vous lancez `/fonce`. Laquelle de ces demandes s'arrêtera au bon moment ?",
    opts: [
      "« Améliore le site du client pendant mon absence. »",
      "« Corrige le script jusqu'à ce qu'il tourne sans erreur sur les 3 fichiers de test. »",
      "« Fais du mieux que tu peux sur le site, tu as deux heures. »",
      "« Occupe-toi de ce qui traîne sur le projet. »",
    ],
    correct: 1,
    pourquoi: [
      "« Améliorer » n'a pas de fin. Rien dans cette phrase ne dit quand s'arrêter.",
      "Exact. La fin est vérifiable : trois fichiers, zéro erreur. Claude sait à quel moment il a terminé.",
      "Une durée n'est pas une condition d'arrêt : elle ne dit pas ce qui doit être atteint.",
      "« Ce qui traîne » est un périmètre inconnu, sans état final défini.",
    ],
    explication: "`/fonce` travaille jusqu'à ce que ce que vous avez décrit soit atteint. Le résultat dépend donc entièrement de la netteté de la fin que vous lui donnez : c'est la seule chose à soigner avant de le lancer.",
    source: null,
  },
  {
    domaine: 'skills',
    q: "Dans votre demande à `/fonce`, vous écrivez : « rédige la page services et mets-la en ligne ». Que se passe-t-il ?",
    opts: [
      "Il rédige puis s'arrête : la mise en ligne est irréversible, il demandera toujours",
      "Il publie en brouillon et attend votre validation",
      "Il refuse la mission : une skill autonome ne publie jamais",
      "Il publie : il ne s'arrête que devant l'irréversible que vous n'avez pas demandé — ici, vous l'avez demandé",
    ],
    correct: 3,
    pourquoi: [
      "Il s'arrête devant l'irréversible non demandé. Votre phrase, elle, le demande explicitement.",
      "Aucune étape de brouillon intermédiaire n'est prévue.",
      "Elle publie très bien si la demande le dit. C'est précisément le risque.",
      "Exact. « …et mets-le en ligne » n'est pas une figure de style : ne l'écrivez que si vous le pensez.",
    ],
    explication: "La règle est symétrique. Ce que vous n'avez pas demandé et qui est irréversible — publier, écrire à un client, supprimer en masse — déclenche une question. Ce que vous avez demandé s'exécute. Relisez votre phrase de lancement comme un ordre, parce que c'en est un.",
    source: null,
  },
  {
    domaine: 'skills',
    q: "Vous travaillez sur un poste où les skills d'équipe ne sont pas installées, et vous démarrez un travail de deux heures. Quelle phrase ajoutez-vous pour éviter de découvrir à la fin qu'il est parti dans la mauvaise direction ?",
