---
import BaseLayout from '../layouts/BaseLayout.astro';

// Évaluation interne des collaborateurs Claude Agency.
// Parcours question par question : on répond, on voit immédiatement pourquoi
// chaque option est juste ou fausse, puis on avance. Aucune donnée n'est envoyée.
// Page utilitaire : noindex, absente du menu.
// Corrigé sourcé sur la documentation officielle (champ `source`).

const DOMAINES = {
  claudecode: 'Claude Code',
  methode: 'Fiabilité et méthode',
  seo: 'SEO client',
  ads: 'Google Ads client',
  perf: 'Site et performance',
  conseil: 'Conseil et cadrage',
};

const PALIERS = [
  {
    min: 17,
    titre: 'Autonome',
    ton: 'ok',
    texte: "Vous pouvez prendre une mission client de bout en bout. Ce qui fera la différence en clientèle, ce n'est plus la connaissance de l'outil, c'est la discipline de vérification.",
  },
  {
    min: 12,
    titre: 'Opérationnel sur cadrage',
    ton: 'moyen',
    texte: "Vous pouvez travailler sur un projet cadré et relu. Reprenez les questions manquées avant de démarrer : ce sont exactement les points où une erreur se paie chez le client.",
  },
  {
    min: 0,
    titre: 'À former avant de démarrer',
    ton: 'ko',
    texte: "Il manque des bases pour intervenir seul. Priorité : les modes de permission de Claude Code, la règle « aucune vérification déclarative », et le réflexe de mesurer avant d'affirmer.",
  },
];

const questions = [
  // ============ Claude Code ============
  {
    domaine: 'claudecode',
    q: 'Quelle est la différence entre `/clear` et `/compact` ?',
    opts: [
      '`/clear` résume la conversation, `/compact` repart de zéro',
      '`/clear` démarre une nouvelle conversation à contexte vide ; `/compact` résume la conversation en cours pour libérer du contexte tout en la poursuivant',
      'Les deux font la même chose, `/compact` est simplement l\'ancien nom',
      '`/clear` ne fonctionne qu\'en mode plan',
    ],
    correct: 1,
    pourquoi: [
      "Inversé. C'est `/compact` qui résume, et `/clear` qui repart à zéro.",
      "Exact. On utilise `/clear` en changeant de sujet, et `/compact` quand la tâche continue mais que le contexte sature.",
      "Non : ce sont deux commandes distinctes, avec deux effets opposés sur l'historique.",
      "Non, le mode de permission n'a rien à voir avec la gestion du contexte.",
    ],
    explication: "Confondre les deux coûte du travail : `/clear` au mauvais moment jette le contexte d'une mission en cours, et rester sans jamais compacter dégrade la qualité des réponses au fil de la conversation.",
    source: 'https://code.claude.com/docs/en/commands',
  },
  {
    domaine: 'claudecode',
    q: "Que dit la documentation du mode `bypassPermissions` (activé par `--dangerously-skip-permissions`) ?",
    opts: [
      "À privilégier sur les projets clients pour aller plus vite",
      "Il ajoute une confirmation supplémentaire avant chaque commande",
      "Il est actif par défaut et il faut le désactiver",
      "À n'utiliser que dans un environnement isolé (conteneur, machine virtuelle) ; sur macOS et Linux, Claude Code refuse même de démarrer dans ce mode en root ou sous `sudo`",
    ],
    correct: 3,
    pourquoi: [
      "L'inverse exact de la consigne officielle. Sur un poste qui contient des données clients, c'est le pire endroit pour ce mode.",
      "Non, il en retire : il désactive les demandes d'autorisation, il n'en ajoute pas.",
      "Non, il n'est jamais actif par défaut. Il faut l'activer explicitement au lancement.",
      "Exact. La doc précise aussi qu'il n'offre aucune protection contre les consignes malveillantes cachées dans un fichier ou une page web.",
