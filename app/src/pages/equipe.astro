---
/**
 * /equipe/ — les consultants de Claude Agency, et pourquoi l'agence existe.
 *
 * Page migrée depuis claudepartners.fr/equipe/ le 2026-09-10 (docs/migration-page-equipe.md).
 * Sur l'annuaire, tout ce qui est chiffré venait des fiches et se recalculait au build.
 * Ici, il n'y a pas de fiches : le tarif, la mission minimale, les livrables, les outils et
 * les parcours sont ÉCRITS EN DUR, relevés sur les fiches claudepartners le 2026-09-10.
 * Si une fiche bouge, cette page devient fausse en silence : la relire avant de la citer,
 * et la mettre à jour dans le même geste que la fiche.
 *
 * Les liens vers claudepartners.fr/prestataires/<slug>/ sont une exception voulue au garde-fou
 * « aucun lien vers claudepartners.fr » (CLAUDE.md), décidée par Julien le 2026-09-10.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { authorPerson } from '../data/author';
import nomenaImg from '../assets/equipe/nomena-andrianiaina.webp';
import meschacImg from '../assets/equipe/meschac-akinocho.webp';
import clotildeImg from '../assets/equipe/clotilde-sandra-menanga.webp';
// Illustrations générées avec fal.ai (nano-banana) le 2026-09-10, prompts dans ~/.claude/generations.jsonl.
import constatImg from '../assets/equipe/dirigeant-en-colere-face-aux-agences-marketing.jpg';
import formationImg from '../assets/equipe/formation-consultants-claude-code-antananarivo.jpg';
import visioImg from '../assets/equipe/visio-quotidienne-consultant-ia-madagascar.jpg';

const illustration = 'not-prose my-6 w-full rounded-2xl border border-sand object-cover';

const site = Astro.site!;

// Relevé sur les fiches claudepartners : Nomena le 2026-09-10, Meschac Akinocho et
// Clotilde Sandra Menanga le 2026-09-18 (tjm_declare, mission_min).
//
// LE TARIF N'EST PLUS UNIQUE depuis le 2026-09-18 : deux consultants sur trois sont à
// 100 €. La page annonce donc « à partir de », et chaque encart porte le tarif de la
// personne. Une constante unique remise ici redeviendrait fausse en silence.
const MISSION_MIN = 'à partir de 5 jours';
const eur = (n: number) => new Intl.NumberFormat('fr-FR').format(n);

const consultants = [
  {
    slug: 'nomena-andrianiaina',
    nom: 'Nomena Andrianiaina',
    role: 'Développeur full-stack',
    ville: 'Antananarivo, Madagascar',
    tarif: 100,
    photo: nomenaImg,
    avis:
      'Développeur formé à l’École nationale d’informatique de Fianarantsoa : Next.js et TypeScript côté web, Spring Boot côté serveur, React Native et Flutter côté mobile, avec le déploiement Docker et la chaîne d’intégration continue. Parcours court, quatre postes en trois ans, licence en cours, avec quatre mois de missions d’IA : un mois chez Meridian Models et trois mois pour l’École de Naturopathie et Sophrologie, sur de l’automatisation de chaînes et de l’intégration d’agents.',
    livrables: [
      'Applications web full-stack TypeScript',
      'API REST documentées et réutilisables',
      'Applications mobiles React Native et Flutter',
      'Intégration continue et déploiement conteneurisé Docker',
    ],
    outils: ['Claude Code', 'Next.js', 'React.js', 'React Native', 'TypeScript', 'Java', 'Spring Boot', 'NestJS', 'PostgreSQL', 'Docker', 'Flutter'],
    parcours: [
      'ALFA OI — software engineer full-stack, depuis mai 2026',
      'Webradio AI — développeur Next.js freelance, 1 an et 7 mois',
      'Orange Digital Center Madagascar — développeur mobile, 6 mois',
      'Ministère de l’Économie et du Plan — développeur Java et React, 4 mois',
    ],
  },
  {
    slug: 'meschac-akinocho-4bfde',
    nom: 'Meschac Akinocho',
    role: 'Consultant SEO et GEO',
    ville: 'Cotonou, Bénin',
    tarif: 100,
    photo: meschacImg,
    avis:
      'Quinze ans de référencement naturel, la rédaction web d’abord puis l’audit technique et la stratégie. Il a tenu trois ans la production éditoriale SEO du site d’actualité tech FredZone.org, pour l’agence Ererefer. C’est lui qui prend votre visibilité dans les moteurs de recherche et dans les moteurs de réponse générative. Il vend l’implémentation autant que le diagnostic : l’audit part avec les correctifs appliqués, sur WordPress comme sur Shopify.',
    livrables: [
      'Audit SEO technique d’un site',
      'Stratégie de contenu et plan de mots-clés',
      'Implémentation des optimisations sur WordPress et Shopify',
      'Optimisation GEO pour les moteurs de réponse générative',
      'Rédaction d’articles, guides, news et comparatifs optimisés',
      'Reporting périodique et suivi des positions',
    ],
    outils: ['Claude Code', 'WordPress', 'Shopify'],
    parcours: [
      'ADAM SEO AGENCY — copywriter et spécialiste SEO, depuis janvier 2023',
      'Ererefer — rédacteur SEO pour FredZone.org, de février 2020 à janvier 2023',
      'EWAY - DAS — directeur général, depuis février 2013',
      'Upwork et Freelancer.com — rédaction web et SEO en indépendant, depuis 2010',
    ],
  },
  {
    slug: 'clotilde-sandra-menanga-1f35e',
    nom: 'Clotilde Sandra Menanga',
    role: 'Community manager et copywriter',
    ville: 'Douala, Cameroun',
    tarif: 100,
    photo: clotildeImg,
    avis:
      'Cinq ans de contenu et de référencement, dont trois sur le marché français. C’est elle qui tient vos réseaux sociaux : elle anime votre profil LinkedIn ou celui de votre entreprise, écrit les posts, et fait le setting — la prospection et la qualification en messagerie, jusqu’au rendez-vous posé dans votre agenda. Son copywriting sert les deux : ce qu’on publie, et ce qu’on envoie. Meilleur score de l’équipe au test Claude Code, 90 sur 100.',
    livrables: [
      'Gestion du profil LinkedIn d’un dirigeant ou d’une entreprise',
      'Community management et calendrier éditorial réseaux sociaux',
      'Copywriting : posts, séquences de messages et pages de vente',
      'Setting : prospection et qualification en messagerie jusqu’au rendez-vous',
      'Rédaction et optimisation de contenu web',
      'Fiches produits e-commerce optimisées',
    ],
    outils: ['Claude Code', 'LinkedIn'],
    parcours: [
      'Douala Digital Impact — SEO exécutive marché français, rédactrice web senior et cheffe de projet, depuis avril 2023',
      'Glotelho — rédactrice de contenu web e-commerce, de mai 2021 à avril 2023',
      'Centre d’incubation des entreprises polytechnique de Douala — gestion de projets, de septembre 2020 à mai 2021',
      'ESSEC de Douala — formation initiale',
    ],
  },
];

// « 100 € » quand les trois sont au même tarif, « à partir de 90 € » dès qu'un
// seul s'en écarte : la phrase suit les fiches au lieu d'être réécrite à la main
// à chaque arrivée. Les tarifs ont été uniques, puis non, puis uniques de nouveau
// entre le 10 et le 18 septembre 2026 — la formulation a suivi toute seule.
const TARIF_MIN = Math.min(...consultants.map((c) => c.tarif));
const TARIF_UNIQUE = consultants.every((c) => c.tarif === TARIF_MIN);
const TARIF_TEXTE = `${TARIF_UNIQUE ? '' : 'à partir de '}${eur(TARIF_MIN)} € HT par jour`;

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Équipe', item: new URL('/equipe/', site).href },
  ],
};
const aboutPage = {
  '@context': 'https://schema.org', '@type': 'AboutPage',
  name: 'L’équipe Claude Agency',
  url: new URL('/equipe/', site).href,
  isPartOf: { '@id': new URL('/#website', site).href },
  publisher: { '@id': new URL('/#organization', site).href },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: consultants.length,
    itemListElement: consultants.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.nom,
      url: `https://claudepartners.fr/prestataires/${c.slug}/`,
    })),
  },
};
---
<BaseLayout
  title="L’équipe : nos consultants IA à Madagascar, au Bénin et au Cameroun — Claude Agency"
  description={`Pourquoi Claude Agency existe, qui sont ses ${consultants.length} consultants formés sur Claude Code, à ${TARIF_TEXTE}, et la garantie de remplacement sous une semaine.`}
  pageSchema={[breadcrumb, aboutPage, authorPerson(site)]}
>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <div class="cp-rise">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Équipe</p>
      <h1 class="mt-3 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-5xl">Pourquoi j’ai créé Claude Agency, et qui travaille pour vous</h1>
    </div>

    <div class="prose prose-stone mt-8 max-w-none">
      <p class="lead">
        Je m’appelle Julien Rayes. Avant de fonder cette agence, j’ai été client d’agences pendant
        cinq ans. Cette page dit ce que j’y ai vu, ce que j’ai décidé d’en faire, et qui sont les
        consultants que je positionne chez vous.
      </p>

      <h2 id="constat" class="scroll-mt-24"><span aria-hidden="true">😤</span> Le constat qui a tout déclenché</h2>
      <Image
        src={constatImg}
        alt="Un dirigeant en costume s’arrache les cheveux face à trois jeunes consultants marketing démunis autour d’une table de réunion"
        widths={[640, 960, 1536]}
        sizes="(min-width: 768px) 42rem, 100vw"
        loading="lazy"
        class={illustration}
      />
      <p>
        En cinq ans, j’ai sollicité une dizaine d’agences marketing pour l’organisme de formation
        que je dirige : des agences SEO, des agences SEA, des agences de gestion de campagnes
        Google Ads, Meta Ads ou TikTok, des agences de prospection sur LinkedIn. <strong>Aucune n’a accepté
        de s’engager sur un résultat.</strong> Toutes s’engageaient sur des <strong>moyens</strong> : un nombre d’heures, un
        nombre d’articles, un budget publicitaire dépensé.
      </p>
      <p>
        Et ce que j’ai reçu, à chaque fois, m’a paru médiocre. Personne n’a su me fixer des
        objectifs clairs et atteignables, et personne, par conséquent, ne les a atteints. <strong>Je payais
        pour de l’activité, pas pour un résultat.</strong>
      </p>
      <p>
        J’ai donc décidé de monter ma propre agence, sur le modèle inverse : <strong>des objectifs écrits
        noir sur blanc, validés ensemble avant de commencer</strong>, et un engagement dessus. Mon pari est
        qu’elle va <strong>trois fois plus vite qu’une agence classique, pour un tarif trois fois inférieur</strong>.
      </p>

      <h2 id="comment" class="scroll-mt-24"><span aria-hidden="true">⚡</span> Comment c’est possible</h2>
      <Image
        src={formationImg}
        alt="Julien Rayes forme deux consultants malgaches sur Claude Code devant un écran de terminal, dans un bureau lumineux d’Antananarivo"
        widths={[640, 960, 1536]}
        sizes="(min-width: 768px) 42rem, 100vw"
        loading="lazy"
        class={illustration}
      />
      <p>
        Deux choses ont changé la donne. La première est <strong>l’IA</strong> : avec Claude Code, un consultant qui
        sait s’en servir produit en heures ce qui prenait des jours. La seconde est <strong>mon équipe,
        basée à Antananarivo, à Cotonou et à Douala</strong>, où une rémunération correcte se situe à un niveau qui
        n’a pas d’équivalent en France. C’est de l’offshore, et je préfère l’écrire que le laisser
        deviner : c’est le seul mécanisme derrière un tarif de <strong>{TARIF_TEXTE}</strong>.
      </p>
      <p>
        <strong>Je les ai formés moi-même sur Claude Code pendant trois mois.</strong> Ils ont passé
        de nombreux tests et sont intervenus sur des cas concrets de clients avant d’être positionnés
        seuls. Les consultants que je vous propose sont donc <strong>expérimentés et opérationnels
        immédiatement</strong> : il n’y a pas de période de montée en compétence à votre charge.
      </p>
      <p>
        Madagascar, le Bénin et le Cameroun ont deux avantages au quotidien sur la plupart des
        destinations offshore. Le <strong>français</strong> y est langue officielle et langue de
        l’enseignement supérieur : il n’y a pas d’anglais de passage entre vous et eux. Et les
        fuseaux horaires ne décalent rien. Madagascar est à <strong>une heure d’avance sur Paris
        en été, deux en hiver</strong> ; le Bénin et le Cameroun sont <strong>à l’heure de Paris en
        hiver, une heure derrière en été</strong>. Vos journées se recouvrent presque entièrement.
      </p>

      <h2 id="garantie" class="scroll-mt-24"><span aria-hidden="true">🔄</span> Si ça ne vous convient pas, vous changez de collaborateur</h2>
      <p>
        C’est la valeur ajoutée de Claude Agency par rapport à un recrutement direct sur une place
        de marché offshore, au même tarif. Le contrat, la facturation et l’encadrement passent par
        l’agence : vous avez <strong>un interlocuteur français, et un seul</strong>, quoi qu’il arrive en cours de
        mission.
      </p>
      <p>
        Et si vous n’êtes pas satisfait, pour quelque raison que ce soit, <strong>vous pouvez changer
        de collaborateur : il est remplacé sous une semaine maximum</strong>, sans que vous ayez à
        justifier votre demande.
      </p>

      <h2 id="consultants" class="scroll-mt-24">Les consultants</h2>
      <p>
        Ils sont {consultants.length}, et leurs périmètres ne se recouvrent pas : le
        <strong>développement</strong>, le <strong>référencement</strong> — moteurs de recherche et
        moteurs de réponse —, et les <strong>réseaux sociaux</strong>, du contenu publié jusqu’au
        rendez-vous pris en messagerie. Vous n’en prenez qu’un si un seul vous sert.
      </p>
      {consultants.map((c) => (
        <section aria-labelledby={c.slug} class="not-prose mt-8 border-t border-sand pt-8">
          <div class="flex items-start gap-5">
            <Image
              src={c.photo}
              alt={`Portrait de ${c.nom}`}
              width={96}
              height={96}
              loading="lazy"
              class="h-24 w-24 shrink-0 rounded-2xl border border-sand object-cover"
            />
            <div>
              <h3 id={c.slug} class="scroll-mt-24 font-display text-2xl font-bold tracking-tight text-ink">{c.nom}</h3>
              <p class="mt-1 text-sm text-muted">{c.role} · {c.ville}</p>
              <p class="mt-2 text-sm text-muted"><strong class="text-base text-brand-700">{eur(c.tarif)} € HT/jour</strong> · {MISSION_MIN}</p>
            </div>
          </div>
          <div class="prose prose-stone mt-5 max-w-none">
            <p>{c.avis}</p>
            <p><strong>Déjà livré :</strong> {c.livrables.join(' · ')}.</p>
            <p><strong>Ses outils :</strong> {c.outils.join(' · ')}.</p>
            <p><strong>Son parcours :</strong></p>
            <ul>{c.parcours.map((x) => <li>{x}</li>)}</ul>
            <p>
              <a href={`https://claudepartners.fr/prestataires/${c.slug}/`} rel="noopener">La fiche complète de {c.nom}</a> sur
              l’annuaire Claude Partners : expertises, secteurs pratiqués, conditions d’intervention.
            </p>
          </div>
        </section>
      ))}

      <h2 id="travailler" class="scroll-mt-24"><span aria-hidden="true">🤝</span> Comment travailler avec eux</h2>
      <Image
        src={visioImg}
        alt="Une dirigeante en visioconférence avec son consultant IA basé à Madagascar, le reporting quotidien affiché sur un second écran"
        widths={[640, 960, 1536]}
        sizes="(min-width: 768px) 42rem, 100vw"
        loading="lazy"
        class={illustration}
      />
      <p>
        Les missions démarrent <strong>{MISSION_MIN}</strong>, à distance. Vous recevez <strong>un reporting
        quotidien</strong> du travail réalisé. Pour commencer, décrivez-moi votre besoin dans le formulaire de
        contact : je vous réponds personnellement sous 24 h ouvrées, et nous écrivons ensemble les
        objectifs de la mission.
      </p>
      <p>
        <a href="/contact/#contact-form" class="not-prose inline-block rounded-lg bg-brand-500 px-5 py-2.5 font-semibold text-white no-underline transition-colors hover:bg-brand-600">Exprimer mon besoin</a>
      </p>
    </div>
  </section>

  <section class="bg-brand-700">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center">
      <h2 class="font-display text-3xl font-extrabold text-cream-50 sm:text-4xl">Testez un consultant une semaine, sans payer</h2>
      <p class="mx-auto mt-4 max-w-xl text-brand-100">Une semaine de consultant IA offerte, contre un avis honnête en vidéo.</p>
      <a href="/semaine-offerte/" class="mt-8 inline-block rounded-lg bg-cream-50 px-7 py-3 font-semibold text-brand-800 transition-colors hover:bg-white">Réserver ma semaine offerte</a>
    </div>
  </section>
</BaseLayout>
